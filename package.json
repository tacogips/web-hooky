{
  "name": "web-hooky",
  "version": "0.1.0",
  "description": "Self-hostable webhook destination server with a vendor addon system, pluggable storage, and a SolidJS admin UI",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun run build:server && bun run build:ui",
    "build:server": "bun build src/main.ts --outdir dist --target bun",
    "build:ui": "bun run scripts/build-admin-ui.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint:biome": "biome check . --diagnostic-level=warn",
    "lint": "biome check . --diagnostic-level=warn && bun run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist"
  },
  "homepage": "https://github.com/tacogips/web-hooky",
  "repository": {
    "type": "git",
    "url": "https://github.com/tacogips/web-hooky"
  },
  "license": "MIT",
  "trustedDependencies": [],
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@biomejs/biome": "2.4.13",
    "@cloudflare/workers-types": "5.20260801.1",
    "@happy-dom/global-registrator": "20.11.1",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.1.14",
    "babel-preset-solid": "1.9.12",
    "typescript": "5.7.2",
    "wrangler": "4.118.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "solid-js": "1.9.14"
  }
}
